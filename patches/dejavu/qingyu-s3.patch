 type listObjectsAPIClient interface {
 	ListObjects(context.Context, *as3.ListObjectsInput, ...func(*as3.Options)) (*as3.ListObjectsOutput, error)
+}
+
+func (s3 *S3) listObjects(ctx context.Context, svc *as3.Client, input *as3.ListObjectsInput) (ret []as3Types.Object, err error) {
+	if s3.options == nil {
+		return listS3Objects(ctx, svc, input)
+	}
+	pageInput := &as3.ListObjectsV2Input{
+		Bucket: input.Bucket, Prefix: input.Prefix, MaxKeys: input.MaxKeys,
+	}
+	seen := map[string]bool{}
+	for {
+		page, err := svc.ListObjectsV2(ctx, pageInput)
+		if err != nil {
+			return nil, err
+		}
+		for _, entry := range page.Contents {
+			if entry.Key == nil || !strings.HasPrefix(*entry.Key, aws.ToString(input.Prefix)) {
+				return nil, errors.New("S3 object outside requested prefix")
+			}
+		}
+		ret = append(ret, page.Contents...)
+		if !aws.ToBool(page.IsTruncated) {
+			return ret, nil
+		}
+		token := aws.ToString(page.NextContinuationToken)
+		if token == "" || seen[token] {
+			return nil, errors.New("S3 pagination did not advance")
+		}
+		seen[token] = true
+		pageInput.ContinuationToken = page.NextContinuationToken
+	}
 }
 
