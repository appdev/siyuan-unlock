+func (s3 *S3) objectMissing(ctx context.Context, key string, err error) bool {
+	if s3.isErrNotFound(err) {
+		return true
+	}
+	var apiErr smithy.APIError
+	if s3.options == nil || !errors.As(err, &apiErr) ||
+		(apiErr.ErrorCode() != "AccessDenied" && apiErr.ErrorCode() != "Forbidden") {
+		return false
+	}
+	page, err := s3.getService().ListObjectsV2(ctx, &as3.ListObjectsV2Input{
+		Bucket: &s3.Conf.S3.Bucket, Prefix: &key, MaxKeys: aws.Int32(1),
+	})
+	return err == nil && !aws.ToBool(page.IsTruncated) && len(page.Contents) == 0
+}
