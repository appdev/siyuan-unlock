diff --git a/kernel/model/unlock_cloud_account_test.go b/kernel/model/unlock_cloud_account_test.go
new file mode 100644
--- /dev/null
+++ b/kernel/model/unlock_cloud_account_test.go
@@ -0,0 +1,26 @@
+package model
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/siyuan-note/siyuan/kernel/conf"
+)
+
+func TestUnlockAccountSurvivesCloudAuthenticationFailure(t *testing.T) {
+	setupCloudAccountAuthTest(t)
+	Conf.Sync.Provider = conf.ProviderS3
+	user := &conf.User{UserId: "0", UserToken: "token", UserSiYuanOneTimePayStatus: 1}
+	Conf.SetUser(user)
+	called := false
+	mockCloudAuthResponse(t, func(request *http.Request) (*http.Response, error) {
+		called = true
+		return cloudAuthResponse(request, http.StatusUnauthorized, ""), nil
+	})
+	if _, err := GetCloudShorthands(1); err == nil || !called {
+		t.Fatal("cloud request must still report authentication failure")
+	}
+	if Conf.GetUser() != user || !IsPaidUser() || Conf.UserData != "persisted-user" {
+		t.Fatal("cloud authentication failure removed local unlock state and blocked S3 sync")
+	}
+}
