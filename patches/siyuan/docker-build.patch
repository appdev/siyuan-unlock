diff --git a/Dockerfile b/Dockerfile
--- a/Dockerfile
+++ b/Dockerfile
@@ -15,6 +15,7 @@
 
 ADD app/ .
 ADD scripts/prepare-ocr.py scripts/ocr-assets.json /scripts/
+ADD kernel/av/lunar_calendar_data.json /kernel/av/lunar_calendar_data.json
 RUN <<EORUN
 #!/bin/bash -e
 apt-get update
@@ -48,12 +49,15 @@
 FROM go-build AS ocr-build
 ARG TARGETARCH
 # 容器保留 Alpine 基础镜像，使用 musl 构建原生运行时和识别辅助进程。
-RUN apk add --no-cache bash cmake make g++ git python3 py3-pip py3-packaging linux-headers
+RUN apk add --no-cache bash cmake make g++ git patch python3 py3-pip py3-packaging linux-headers
 RUN git clone --no-checkout https://github.com/microsoft/onnxruntime /onnxruntime \
     && cd /onnxruntime \
     && git checkout 3a728b75062256951b6e19ce718907cf1a1d4cf0 \
     && git submodule update --init --recursive
-RUN python3 /onnxruntime/tools/ci_build/build.py --build_dir /onnxruntime/build \
+# ARM32 containers on ARM64 hosts inherit aarch64 from uname unless the
+# execution personality is set. Keep CMake and cpuinfo on the target ABI.
+RUN if [ "$TARGETARCH" = arm ]; then apk add --no-cache setarch; set -- setarch linux32; else set --; fi; \
+    "$@" python3 /onnxruntime/tools/ci_build/build.py --build_dir /onnxruntime/build \
     --config Release --update --build --parallel 2 --build_shared_lib \
     --skip_tests --allow_running_as_root --compile_no_warning_as_error
 RUN mkdir -p /ocr/linux-${TARGETARCH} \
