+	if err := os.WriteFile(filepath.Join(first.DataPath, "note.txt"), []byte(note), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := first.Index("first", true, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := first.SyncUpload(map[string]any{}); err != nil {
+		t.Fatal(err)
+	}
+	second, secondStore := newRepo("second")
+	defer secondStore.client.Logout(ctx)
+	if err := os.WriteFile(filepath.Join(second.DataPath, "seed.txt"), []byte("seed"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := second.Index("second", true, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := second.SyncDownload(map[string]any{}); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(filepath.Join(second.DataPath, "note.txt"))
+	if err != nil || string(got) != note {
+		t.Fatalf("note round trip: %q, %v", got, err)
+	}
+	mu.Lock()
+	if deletes == 0 || configRequests < 3 || rejectedRequests != 1 || reads == 0 {
+		t.Errorf("expected deletion, STS refresh and reads; got %d, %d, %d, %d", deletes, configRequests, rejectedRequests, reads)
+	}
+	configVersion++
+	mu.Unlock()
+	firstStore.client.mu.Lock()
+	firstStore.client.rejected = "id"
+	firstStore.client.mu.Unlock()
+	if _, err := firstStore.Retrieve(ctx); !errors.Is(err, ErrChanged) {
+		t.Fatalf("expected old storage generation to stop: %v", err)
+	}
+}
