diff --git a/kernel/api/qingyu.go b/kernel/api/qingyu.go
new file mode 100644
index 0000000..cc362e9
--- /dev/null
+++ b/kernel/api/qingyu.go
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package api
+
+import (
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+	"github.com/siyuan-note/siyuan/kernel/apicontract"
+	"github.com/siyuan-note/siyuan/kernel/model"
+)
+
+var getQingYuAccount = contractHandler(apicontract.GetQingYuAccount, func(c *gin.Context, _ apicontract.EmptyRequest) apicontract.Response[apicontract.QingYuStatus] {
+	status, err := model.QingYuAccount(c.Request.Context())
+	return qingyuAccountResponse(status, err)
+})
+
+var loginQingYu = contractHandler(apicontract.LoginQingYu, func(c *gin.Context, input apicontract.QingYuLoginRequest) apicontract.Response[apicontract.QingYuStatus] {
+	status, err := model.LoginQingYu(c.Request.Context(), input.Username, input.Password, input.Remember)
+	return qingyuAccountResponse(status, err)
+}, func(c *gin.Context) *apicontract.Response[apicontract.QingYuStatus] {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 16<<10)
+	return nil
+})
+
+var logoutQingYu = contractHandler(apicontract.LogoutQingYu, func(c *gin.Context, _ apicontract.EmptyRequest) apicontract.Response[apicontract.QingYuStatus] {
+	err := model.LogoutQingYu(c.Request.Context())
+	status, _ := model.QingYuAccount(c.Request.Context())
+	if err != nil && !status.SignedIn {
+		return apicontract.SuccessWithMessage(apicontract.QingYuStatus(status), err.Error())
+	}
+	return qingyuAccountResponse(status, err)
+})
+
+func qingyuAccountResponse(status model.QingYuStatus, err error) apicontract.Response[apicontract.QingYuStatus] {
+	if err != nil {
+		return apicontract.Failure[apicontract.QingYuStatus](-1, err.Error())
+	}
+	return apicontract.Success(apicontract.QingYuStatus(status))
+}
