diff --git a/kernel/model/qingyu.go b/kernel/model/qingyu.go
new file mode 100644
index 0000000..9cc3927
--- /dev/null
+++ b/kernel/model/qingyu.go
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package model
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/siyuan-note/dejavu/cloud"
+	"github.com/siyuan-note/siyuan/kernel/conf"
+	"github.com/siyuan-note/siyuan/kernel/qingyustorage"
+	"github.com/siyuan-note/siyuan/kernel/util"
+	"github.com/zalando/go-keyring"
+)
+
+const qingyuKeyringService = "SiYuan QingYu session"
+
+var qingyuSession struct {
+	mu         sync.Mutex
+	client     *qingyustorage.Client
+	remembered *atomic.Bool
+}
+
+type QingYuStatus struct {
+	SignedIn   bool   `json:"signedIn"`
+	Name       string `json:"name"`
+	CanUpload  bool   `json:"canUpload"`
+	Remembered bool   `json:"remembered"`
+	Enabled    bool   `json:"enabled"`
+	UsedBytes  int64  `json:"usedBytes"`
+	QuotaBytes int64  `json:"quotaBytes"`
+}
+
+func qingyuKeyringAccount() string {
+	return fmt.Sprintf("%x", sha256.Sum256([]byte(util.WorkspaceDir+"\x00"+qingyustorage.Origin)))
+}
+
+func qingyuTokensCallback(account string, remembered *atomic.Bool) func(qingyustorage.Tokens) {
+	return func(tokens qingyustorage.Tokens) {
+		if tokens.RefreshToken == "" {
+			_ = keyring.Delete(qingyuKeyringService, account)
+			remembered.Store(false)
+			return
+		}
+		tokens.AccessToken = ""
+		data, err := json.Marshal(tokens)
+		remembered.Store(err == nil && keyring.Set(qingyuKeyringService, account, string(data)) == nil)
+	}
+}
+
+func qingyuClientLocked() *qingyustorage.Client {
+	if qingyuSession.client == nil {
+		account := qingyuKeyringAccount()
+		var tokens qingyustorage.Tokens
+		remembered := &atomic.Bool{}
+		if data, err := keyring.Get(qingyuKeyringService, account); err == nil && json.Unmarshal([]byte(data), &tokens) == nil {
+			remembered.Store(tokens.RefreshToken != "")
+		}
+		qingyuSession.client = qingyustorage.New(qingyustorage.Origin, nil, tokens, qingyuTokensCallback(account, remembered))
+		qingyuSession.remembered = remembered
+	}
+	return qingyuSession.client
+}
+
+func checkedQingYuStatus(ctx context.Context, client *qingyustorage.Client) (qingyustorage.Status, error) {
+	status, err := client.Probe(ctx)
+	if err != nil {
+		return status, err
+	}
+	if binding := Conf.LoadSync().QingYuBinding; binding == "" || binding != status.Binding() {
+		return qingyustorage.Status{}, qingyustorage.Error("account_changed")
+	}
+	return status, nil
+}
+
+func QingYuAccount(ctx context.Context) (QingYuStatus, error) {
+	qingyuSession.mu.Lock()
+	defer qingyuSession.mu.Unlock()
+	client := qingyuClientLocked()
+	if !client.SignedIn() {
+		return QingYuStatus{}, nil
+	}
+	status, err := checkedQingYuStatus(ctx, client)
+	if err != nil {
+		return QingYuStatus{}, err
+	}
+	return qingyuPublicStatus(ctx, client, status), nil
+}
+
+func LoginQingYu(ctx context.Context, username, password string, remember bool) (QingYuStatus, error) {
+	if strings.TrimSpace(username) == "" || password == "" || len(username) > 254 || len(password) > 4096 {
+		return QingYuStatus{}, qingyustorage.Error("invalid_request")
+	}
+	unlock := lockAssetSourceChange()
+	defer unlock()
+	qingyuSession.mu.Lock()
+	defer qingyuSession.mu.Unlock()
+	if Conf.LoadSync().Provider != conf.ProviderQingYu {
+		return QingYuStatus{}, qingyustorage.ErrChanged
+	}
+	candidate := qingyustorage.New(qingyustorage.Origin, nil, qingyustorage.Tokens{}, nil)
+	if err := candidate.Login(ctx, strings.TrimSpace(username), password); err != nil {
+		return QingYuStatus{}, err
+	}
+	status, err := candidate.Probe(ctx)
+	if err != nil {
+		_ = candidate.Logout(ctx)
+		return QingYuStatus{}, err
+	}
+	binding := status.Binding()
+	if previous := Conf.LoadSync().QingYuBinding; previous != "" && previous != binding {
+		_ = candidate.Logout(ctx)
+		return QingYuStatus{}, qingyustorage.Error("account_changed")
+	}
+	if qingyuSession.client != nil {
+		_ = qingyuSession.client.Logout(ctx)
+	}
+	account := qingyuKeyringAccount()
+	remembered := &atomic.Bool{}
+	if remember {
+		candidate.Remember(qingyuTokensCallback(account, remembered))
+	} else {
+		_ = keyring.Delete(qingyuKeyringService, account)
+	}
+	qingyuSession.client, qingyuSession.remembered = candidate, remembered
+	UpdateSyncConf(func(sync *conf.Sync) { sync.QingYuBinding = binding })
+	return qingyuPublicStatus(ctx, candidate, status), nil
+}
+
+func qingyuPublicStatus(ctx context.Context, client *qingyustorage.Client, status qingyustorage.Status) QingYuStatus {
+	used, err := client.Usage(ctx)
+	if err != nil {
+		used = -1
+	}
+	return QingYuStatus{SignedIn: client.SignedIn(), Name: status.Name, CanUpload: status.CanUpload,
+		Remembered: qingyuSession.remembered.Load(), Enabled: Conf.LoadSync().Enabled, UsedBytes: used, QuotaBytes: status.Quota}
+}
+
+func LogoutQingYu(ctx context.Context) error {
+	unlock := lockAssetSourceChange()
+	defer unlock()
+	if Conf.LoadSync().Provider == conf.ProviderQingYu {
+		if err := requireCompleteAssetDownloads(); err != nil {
+			return err
+		}
+		UpdateSyncConf(func(sync *conf.Sync) { sync.Enabled = false })
+	}
+	qingyuSession.mu.Lock()
+	defer qingyuSession.mu.Unlock()
+	client := qingyuClientLocked()
+	if !client.SignedIn() {
+		return nil
+	}
+	err := client.Logout(ctx)
+	qingyuSession.client = qingyustorage.New(qingyustorage.Origin, nil, qingyustorage.Tokens{}, nil)
+	return err
+}
+
+func qingyuCloud(config *cloud.Conf, refresh bool) (cloud.Cloud, error) {
+	qingyuSession.mu.Lock()
+	defer qingyuSession.mu.Unlock()
+	client := qingyuClientLocked()
+	if !refresh {
+		if cached, err := client.CachedStore(config); err == nil {
+			return cached, nil
+		}
+		return &cloud.BaseCloud{Conf: config}, nil
+	}
+	status, err := checkedQingYuStatus(context.Background(), client)
+	if err != nil {
+		return nil, err
+	}
+	return client.Store(config, status)
+}
