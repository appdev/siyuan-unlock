diff --git a/kernel/qingyustorage/client.go b/kernel/qingyustorage/client.go
new file mode 100644
index 0000000..9aa231a
--- /dev/null
+++ b/kernel/qingyustorage/client.go
@@ -0,0 +1,389 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package qingyustorage
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+const Origin = "https://api.qynotes.com"
+
+type Error string
+
+func (e Error) Error() string { return string(e) }
+
+const (
+	ErrSignedOut = Error("signed_out")
+	ErrChanged   = Error("storage_config_changed")
+	ErrInvalid   = Error("invalid_response")
+	ErrExpired   = Error("storage_expired")
+)
+
+var prefixPattern = regexp.MustCompile(`^users/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/$`)
+
+type Config struct {
+	ProtocolVersion     int
+	Endpoint            string
+	Bucket              string
+	Region              string
+	Prefix              string
+	Repository          string
+	Provider            string
+	SiyuanNamespace     string
+	ConfigVersion       int64
+	ForcePathStyle      bool
+	ConcurrentReqs      int
+	ReadOnly            bool
+	UploadMode          string
+	DeleteMode          string
+	CredentialType      string
+	AccessKeyID         string
+	SecretAccessKey     string
+	SessionToken        string
+	CredentialsExpireAt time.Time
+}
+
+func (c Config) validate() error {
+	endpoint, err := url.Parse(c.Endpoint)
+	if err != nil || endpoint.Scheme != "https" || endpoint.Hostname() == "" ||
+		endpoint.User != nil || endpoint.RawQuery != "" || endpoint.ForceQuery || endpoint.Fragment != "" ||
+		strings.ContainsAny(c.Endpoint, "\\#\r\n") || c.ProtocolVersion != 2 ||
+		c.SiyuanNamespace != "siyuan-v2/" || !prefixPattern.MatchString(c.Prefix) ||
+		c.ConfigVersion < 1 || c.ConfigVersion > 1<<53-1 ||
+		(c.Provider != "tos" && c.Provider != "s3") || !c.ReadOnly ||
+		c.UploadMode != "presigned" || c.DeleteMode != "server" ||
+		(c.CredentialType != "" && c.CredentialType != "sts") ||
+		!visible(c.Bucket) || !visible(c.Region) || !visible(c.Repository) ||
+		!visible(c.AccessKeyID) || !visible(c.SecretAccessKey) || !visible(c.SessionToken) {
+		return ErrInvalid
+	}
+	if time.Until(c.CredentialsExpireAt) < 2*time.Minute {
+		return Error("storage_credentials_expiring")
+	}
+	return nil
+}
+
+func visible(s string) bool {
+	return s != "" && !strings.ContainsFunc(s, func(r rune) bool { return r < 33 || r > 126 })
+}
+
+func (c Config) sameSource(b Config) bool {
+	return c.Prefix == b.Prefix && c.Repository == b.Repository && c.ConfigVersion == b.ConfigVersion &&
+		c.Provider == b.Provider && c.Endpoint == b.Endpoint && c.Bucket == b.Bucket &&
+		c.Region == b.Region && c.ForcePathStyle == b.ForcePathStyle && c.SiyuanNamespace == b.SiyuanNamespace
+}
+
+type Tokens struct {
+	AccessToken      string
+	RefreshToken     string
+	SessionExpiresAt int64
+}
+
+func (t Tokens) valid() bool {
+	return visible(t.RefreshToken) && t.SessionExpiresAt > time.Now().Unix()
+}
+
+type Status struct {
+	AccountID  string
+	Name       string
+	Repository string
+	Prefix     string
+	CanUpload  bool
+	Quota      int64
+}
+
+func (s Status) Binding() string {
+	identity, _ := json.Marshal([]string{s.AccountID, s.Repository, s.Prefix})
+	return fmt.Sprintf("%x", sha256.Sum256(identity))
+}
+
+type Client struct {
+	origin     string
+	http       *http.Client
+	mu         sync.Mutex
+	tokens     Tokens
+	config     Config
+	checkedAt  time.Time
+	status     Status
+	life       context.Context
+	cancel     context.CancelFunc
+	rejected   string
+	cooldown   map[string]cooldown
+	saveTokens func(Tokens)
+}
+
+type cooldown struct {
+	until time.Time
+	err   error
+}
+
+func New(origin string, transport http.RoundTripper, tokens Tokens, saveTokens func(Tokens)) *Client {
+	life, cancel := context.WithCancel(context.Background())
+	return &Client{origin: origin, http: &http.Client{Transport: transport, Timeout: 20 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }},
+		tokens: tokens, life: life, cancel: cancel, cooldown: map[string]cooldown{}, saveTokens: saveTokens}
+}
+
+func (c *Client) Login(ctx context.Context, email, password string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	var tokens Tokens
+	err := c.call(ctx, "login", "", map[string]string{"username": email, "password": password}, &tokens)
+	if err != nil {
+		return err
+	}
+	if !tokens.valid() || !visible(tokens.AccessToken) {
+		return ErrInvalid
+	}
+	c.tokens = tokens
+	c.persist()
+	return nil
+}
+
+func (c *Client) Logout(ctx context.Context) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.cancel()
+	err := c.authorized(ctx, "logout", struct{}{}, nil)
+	c.tokens, c.status, c.config = Tokens{}, Status{}, Config{}
+	c.persist()
+	return err
+}
+
+func (c *Client) persist() {
+	if c.saveTokens != nil {
+		c.saveTokens(c.tokens)
+	}
+}
+
+func (c *Client) Remember(save func(Tokens)) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.saveTokens = save
+	c.persist()
+}
+
+func (c *Client) SignedIn() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.tokens.valid()
+}
+
+func (c *Client) Probe(ctx context.Context) (Status, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	var user struct{ ID, Name, Email string }
+	if err := c.authorized(ctx, "me", nil, &user); err != nil {
+		return Status{}, err
+	}
+	if !visible(user.ID) {
+		return Status{}, ErrInvalid
+	}
+	var plan struct {
+		Active     bool
+		QuotaBytes int64
+	}
+	if err := c.authorized(ctx, "subscription", nil, &plan); err != nil {
+		return Status{}, err
+	}
+	if c.status.AccountID != "" && user.ID != c.status.AccountID {
+		c.invalidate()
+		return Status{}, Error("account_changed")
+	}
+	if err := c.refreshConfig(ctx, true); err != nil {
+		return Status{}, err
+	}
+	name := user.Email
+	if name == "" {
+		name = user.Name
+	}
+	canUpload := plan.Active && plan.QuotaBytes > 0
+	if c.status.AccountID != "" && canUpload != c.status.CanUpload {
+		c.cancel()
+		c.life, c.cancel = context.WithCancel(context.Background())
+	}
+	c.status = Status{AccountID: user.ID, Name: name, Repository: c.config.Repository,
+		Prefix: c.config.Prefix, CanUpload: canUpload, Quota: max(0, plan.QuotaBytes)}
+	return c.status, nil
+}
+
+func (c *Client) Usage(ctx context.Context) (int64, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	var usage struct{ UsedBytes int64 }
+	err := c.authorized(ctx, "usage", nil, &usage)
+	return usage.UsedBytes, err
+}
+
+func (c *Client) invalidate() {
+	c.cancel()
+	c.life, c.cancel = context.WithCancel(context.Background())
+	c.config = Config{}
+	c.rejected = ""
+}
+
+func (c *Client) refreshConfig(ctx context.Context, checkBinding bool) error {
+	if c.rejected == "" && time.Until(c.config.CredentialsExpireAt) >= 2*time.Minute &&
+		(!checkBinding || time.Since(c.checkedAt) < 10*time.Second) {
+		return nil
+	}
+	request := map[string]string{}
+	if c.rejected != "" {
+		request["rejectedKey"] = c.rejected
+	}
+	var config Config
+	if err := c.authorized(ctx, "storage-config", request, &config); err != nil {
+		return err
+	}
+	if err := config.validate(); err != nil {
+		return err
+	}
+	if c.config.ConfigVersion != 0 && !c.config.sameSource(config) {
+		c.invalidate()
+		return ErrChanged
+	}
+	c.config, c.rejected, c.checkedAt = config, "", time.Now()
+	return nil
+}
+
+func (c *Client) authorized(ctx context.Context, action string, input, output any) error {
+	if !c.tokens.valid() {
+		c.invalidate()
+		return ErrSignedOut
+	}
+	var err error = Error("invalid_token")
+	if c.tokens.AccessToken != "" {
+		err = c.call(ctx, action, c.tokens.AccessToken, input, output)
+	}
+	if err == Error("invalid_token") {
+		var fresh Tokens
+		err = c.call(ctx, "refresh", "", map[string]string{"refreshToken": c.tokens.RefreshToken}, &fresh)
+		if err == nil {
+			if !fresh.valid() || !visible(fresh.AccessToken) || fresh.SessionExpiresAt != c.tokens.SessionExpiresAt {
+				return ErrInvalid
+			}
+			c.tokens = fresh
+			c.persist()
+			err = c.call(ctx, action, c.tokens.AccessToken, input, output)
+		}
+	}
+	switch err {
+	case Error("invalid_token"), Error("invalid_refresh_token"), ErrSignedOut, Error("session_expiring"):
+		c.invalidate()
+		c.tokens = Tokens{}
+		c.persist()
+	case ErrChanged, Error("storage_busy"), Error("account_changed"):
+		c.invalidate()
+	}
+	return err
+}
+
+func (c *Client) call(ctx context.Context, action, token string, input, output any) error {
+	if wait := c.cooldown[action]; time.Now().Before(wait.until) {
+		return wait.err
+	}
+	method, body := http.MethodGet, io.Reader(nil)
+	if input != nil {
+		data, err := json.Marshal(input)
+		if err != nil {
+			return ErrInvalid
+		}
+		method, body = http.MethodPost, bytes.NewReader(data)
+	}
+	request, err := http.NewRequestWithContext(ctx, method, c.origin+"/api/client/v1/"+action, body)
+	if err != nil {
+		return ErrInvalid
+	}
+	if input != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+	if token != "" {
+		request.Header.Set("Authorization", "Bearer "+token)
+	}
+	response, err := c.http.Do(request)
+	if err != nil {
+		return Error("network")
+	}
+	defer response.Body.Close()
+	limit := int64(256 << 10)
+	if action == "upload-authorize" {
+		limit = 1 << 20
+	}
+	if response.StatusCode == 429 || response.StatusCode >= 500 {
+		code, delay := Error("temporarily_unavailable"), 5*time.Second
+		if response.StatusCode == 429 {
+			code, delay = Error("rate_limited"), time.Minute
+		}
+		now := time.Now()
+		if value := response.Header.Get("Retry-After"); value != "" {
+			if seconds, err := strconv.ParseInt(value, 10, 32); err == nil && seconds >= 0 {
+				delay = time.Duration(seconds) * time.Second
+			} else if date, err := http.ParseTime(value); err == nil && date.After(now) {
+				delay = date.Sub(now)
+			}
+		}
+		c.cooldown[action] = cooldown{now.Add(delay), code}
+		return code
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, limit+1))
+	var result struct {
+		Status string
+		Code   string
+		Data   json.RawMessage
+	}
+	if err != nil || int64(len(data)) > limit || json.Unmarshal(data, &result) != nil {
+		return ErrInvalid
+	}
+	if response.StatusCode != 200 || result.Status != "ok" || result.Code != "ok" {
+		return errorCode(response.StatusCode, result.Status, result.Code)
+	}
+	if output != nil && (len(result.Data) == 0 || json.Unmarshal(result.Data, output) != nil) {
+		return ErrInvalid
+	}
+	return nil
+}
+
+func errorCode(status int, envelope, code string) error {
+	if envelope == "error" {
+		switch status {
+		case 400:
+			if code == "invalid_request" {
+				return Error(code)
+			}
+		case 401:
+			switch code {
+			case "login_failed", "invalid_token", "invalid_refresh_token", "session_expiring":
+				return Error(code)
+			}
+		case 403:
+			switch code {
+			case "storage_expired", "email_unverified", "subscription_required":
+				return Error(code)
+			}
+		case 409:
+			switch code {
+			case "storage_config_changed", "storage_busy", "quota_exceeded":
+				return Error(code)
+			}
+		}
+	}
+	return ErrInvalid
+}
+
+func IsSignedOut(err error) bool {
+	return errors.Is(err, ErrSignedOut) || errors.Is(err, Error("session_expiring")) ||
+		errors.Is(err, Error("invalid_token")) || errors.Is(err, Error("invalid_refresh_token"))
+}
diff --git a/kernel/qingyustorage/cloud.go b/kernel/qingyustorage/cloud.go
new file mode 100644
index 0000000..adc21dc
--- /dev/null
+++ b/kernel/qingyustorage/cloud.go
@@ -0,0 +1,533 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package qingyustorage
+
+import (
+	"bytes"
+	"context"
+	"crypto/md5"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/xml"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/aws/retry"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/siyuan-note/dejavu"
+	"github.com/siyuan-note/dejavu/cloud"
+)
+
+const maxObject = 64 << 20
+
+type Store struct {
+	*cloud.S3
+	client  *Client
+	config  Config
+	status  Status
+	life    context.Context
+	reader  *s3.Client
+	put     *http.Client
+	batchMu sync.Mutex
+	batch   *grantBatch
+}
+
+func (c *Client) Store(conf *cloud.Conf, expected Status) (cloud.Cloud, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.store(conf, expected)
+}
+
+func (c *Client) CachedStore(conf *cloud.Conf) (cloud.Cloud, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if conf.UserID == "" || conf.UserID != c.status.Binding() {
+		return nil, ErrChanged
+	}
+	return c.store(conf, c.status)
+}
+
+func (c *Client) store(conf *cloud.Conf, expected Status) (cloud.Cloud, error) {
+	if !c.tokens.valid() {
+		return nil, ErrSignedOut
+	}
+	if c.config.ConfigVersion == 0 || c.status.AccountID != expected.AccountID ||
+		c.status.Repository != expected.Repository || c.status.Prefix != expected.Prefix {
+		return nil, ErrChanged
+	}
+	store := &Store{client: c, config: c.config, status: c.status, life: c.life,
+		put: &http.Client{Transport: c.http.Transport, Timeout: 300 * time.Second, CheckRedirect: c.http.CheckRedirect}}
+	conf.S3 = &cloud.ConfS3{Endpoint: c.config.Endpoint, Bucket: c.config.Bucket,
+		Region: c.config.Region, PathStyle: c.config.ForcePathStyle, Timeout: 60,
+		ConcurrentReqs: max(1, min(8, c.config.ConcurrentReqs))}
+	if c.config.ConcurrentReqs == 0 {
+		conf.S3.ConcurrentReqs = 2
+	}
+	conf.AvailableSize = c.status.Quota
+	if !c.status.CanUpload {
+		conf.AvailableSize = 1<<63 - 1
+	}
+	reader := &http.Client{Transport: readTransport{store}, Timeout: time.Minute, CheckRedirect: c.http.CheckRedirect}
+	options := func(o *s3.Options) {
+		o.HTTPClient, o.Credentials = reader, store
+		o.Region, o.UsePathStyle = store.config.Region, store.config.ForcePathStyle
+		o.BaseEndpoint = aws.String(store.config.Endpoint)
+		o.Retryer = retry.AddWithErrorCodes(retry.NewStandard(func(o *retry.StandardOptions) {
+			o.MaxAttempts = 2
+		}), "ExpiredToken", "InvalidToken", "InvalidAccessKeyId", "InvalidSecurityToken", "SecurityTokenExpired")
+	}
+	store.reader = s3.New(s3.Options{}, options)
+	store.S3 = cloud.NewScopedS3(&cloud.BaseCloud{Conf: conf}, reader, c.config.Prefix+c.config.SiyuanNamespace, options)
+	return store, nil
+}
+
+func (s *Store) Retrieve(ctx context.Context) (aws.Credentials, error) {
+	s.client.mu.Lock()
+	defer s.client.mu.Unlock()
+	if s.life.Err() != nil {
+		return aws.Credentials{}, ErrChanged
+	}
+	if err := s.client.refreshConfig(ctx, false); err != nil {
+		return aws.Credentials{}, err
+	}
+	if s.life.Err() != nil || !s.config.sameSource(s.client.config) {
+		return aws.Credentials{}, ErrChanged
+	}
+	c := s.client.config
+	return aws.Credentials{AccessKeyID: c.AccessKeyID, SecretAccessKey: c.SecretAccessKey,
+		SessionToken: c.SessionToken, Source: "QingYu read-only STS", CanExpire: true, Expires: c.CredentialsExpireAt}, nil
+}
+
+func (s *Store) ReadOnly() bool { return !s.status.CanUpload }
+
+func (s *Store) GetRepos() ([]*cloud.Repo, int64, error) {
+	return []*cloud.Repo{{Name: s.Conf.Dir}}, 0, s.life.Err()
+}
+
+type readTransport struct{ store *Store }
+
+func (t readTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	s := t.store
+	if s.life.Err() != nil {
+		return nil, ErrChanged
+	}
+	if request.Method != http.MethodGet && request.Method != http.MethodHead {
+		return nil, ErrInvalid
+	}
+	ctx, cancel := context.WithCancel(request.Context())
+	stop := context.AfterFunc(s.life, cancel)
+	cleanup := func() { stop(); cancel() }
+	transport := s.client.http.Transport
+	if transport == nil {
+		transport = http.DefaultTransport
+	}
+	response, err := transport.RoundTrip(request.WithContext(ctx))
+	if err != nil {
+		cleanup()
+		return nil, Error("network")
+	}
+	if response.StatusCode < 400 {
+		if response.ContentLength > maxObject {
+			response.Body.Close()
+			cleanup()
+			return nil, Error("storage_object_too_large")
+		}
+		response.Body = &readBody{ReadCloser: response.Body, close: cleanup, remaining: maxObject}
+		return response, nil
+	}
+	defer cleanup()
+	var body struct {
+		Code string `xml:"Code"`
+	}
+	data, _ := io.ReadAll(io.LimitReader(response.Body, 16<<10))
+	response.Body.Close()
+	_ = xml.Unmarshal(data, &body)
+	if body.Code == "" {
+		body.Code = response.Header.Get("X-Amz-Error-Code")
+	}
+	if body.Code == "" {
+		body.Code = response.Header.Get("X-Tos-Error-Code")
+	}
+	if response.StatusCode == 400 || response.StatusCode == 401 || response.StatusCode == 403 {
+		switch body.Code {
+		case "ExpiredToken", "InvalidToken", "InvalidAccessKeyId", "InvalidSecurityToken", "SecurityTokenExpired":
+			s.client.mu.Lock()
+			if request.Header.Get("X-Amz-Security-Token") == s.client.config.SessionToken {
+				s.client.rejected = s.client.config.AccessKeyID
+			}
+			s.client.mu.Unlock()
+		}
+	}
+	if !errorName(body.Code) {
+		body.Code = ""
+	}
+	safeBody := "<Error><Code>" + body.Code + "</Code></Error>"
+	response.Body = io.NopCloser(strings.NewReader(safeBody))
+	response.ContentLength = int64(len(safeBody))
+	return response, nil
+}
+
+type readBody struct {
+	io.ReadCloser
+	close     func()
+	remaining int
+}
+
+func (r *readBody) Read(buffer []byte) (int, error) {
+	n, err := r.ReadCloser.Read(buffer[:min(len(buffer), r.remaining+1)])
+	if n > r.remaining {
+		return 0, Error("storage_object_too_large")
+	}
+	r.remaining -= n
+	return n, err
+}
+
+func (r *readBody) Close() error {
+	defer r.close()
+	return r.ReadCloser.Close()
+}
+
+func errorName(code string) bool {
+	switch code {
+	case "ExpiredToken", "InvalidToken", "InvalidAccessKeyId", "InvalidSecurityToken",
+		"SecurityTokenExpired", "AccessDenied", "Forbidden", "NoSuchKey", "NotFound", "NoSuchBucket",
+		"SignatureDoesNotMatch", "RequestTimeTooSkewed", "SlowDown", "InternalError", "ServiceUnavailable":
+		return true
+	}
+	return false
+}
+
+type uploadObject struct {
+	Key         string `json:"key"`
+	Size        int    `json:"size"`
+	MD5         string `json:"md5"`
+	IfMatch     string `json:"ifMatch,omitempty"`
+	IfNoneMatch string `json:"ifNoneMatch,omitempty"`
+}
+
+type uploadGrant struct {
+	ID        string
+	Key       string
+	URL       string
+	ExpiresAt time.Time
+	Headers   map[string]string
+}
+
+func (s *Store) objectKey(relative string) (string, error) {
+	if relative == "" || path.Clean(relative) != relative || strings.HasPrefix(relative, "/") ||
+		!filepath.IsLocal(filepath.FromSlash(relative)) || strings.ContainsAny(relative, "%\\\x00\r\n") {
+		return "", ErrInvalid
+	}
+	return s.config.Prefix + s.config.SiyuanNamespace + relative, nil
+}
+
+func (s *Store) UploadObject(relative string, overwrite bool) (int64, error) {
+	if _, err := s.objectKey(relative); err != nil {
+		return 0, err
+	}
+	file, err := os.Open(filepath.Join(s.Conf.RepoPath, filepath.FromSlash(relative)))
+	if err != nil {
+		return 0, err
+	}
+	defer file.Close()
+	data, err := io.ReadAll(io.LimitReader(file, maxObject+1))
+	if err != nil {
+		return 0, err
+	}
+	return s.UploadBytes(relative, data, overwrite)
+}
+
+func (s *Store) UploadBytes(relative string, data []byte, overwrite bool) (int64, error) {
+	if !s.status.CanUpload {
+		return 0, ErrExpired
+	}
+	if len(data) > maxObject {
+		return 0, Error("storage_object_too_large")
+	}
+	key, err := s.objectKey(relative)
+	if err != nil {
+		return 0, err
+	}
+	digest := md5.Sum(data)
+	object := uploadObject{Key: key, Size: len(data), MD5: base64.StdEncoding.EncodeToString(digest[:])}
+	if relative == "lock-sync" {
+		if err := s.lockCondition(&object, data); err != nil {
+			return 0, err
+		}
+	} else if !overwrite {
+		object.IfNoneMatch = "*"
+	}
+	for attempt := 0; attempt < 2; attempt++ {
+		grant, err := s.authorize(object)
+		if err != nil {
+			return 0, err
+		}
+		err = s.upload(grant, data)
+		if err == nil {
+			return int64(len(data)), nil
+		}
+		if err == Error("storage_conflict") && !overwrite && relative != "lock-sync" {
+			if _, headErr := s.head(key); headErr == nil {
+				return 0, nil
+			}
+		}
+		if err == Error("storage_conflict") && relative == "lock-sync" {
+			return 0, dejavu.ErrCloudLocked
+		}
+		if err != Error("storage_upload_expired") || attempt > 0 {
+			return 0, err
+		}
+	}
+	return 0, Error("storage_upload_expired")
+}
+
+func (s *Store) lockCondition(object *uploadObject, data []byte) error {
+	var desired, current struct {
+		DeviceID string
+		Time     int64
+	}
+	if json.Unmarshal(data, &desired) != nil || desired.DeviceID == "" {
+		return ErrInvalid
+	}
+	ctx, cancel := context.WithTimeout(s.life, 20*time.Second)
+	defer cancel()
+	output, err := s.reader.GetObject(ctx, &s3.GetObjectInput{Bucket: &s.config.Bucket, Key: &object.Key})
+	if err != nil {
+		if _, missing := s.S3.DownloadObject("lock-sync"); errors.Is(missing, cloud.ErrCloudObjectNotFound) {
+			object.IfNoneMatch = "*"
+			return nil
+		}
+		return err
+	}
+	defer output.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(output.Body, 4097))
+	if err != nil || len(body) > 4096 || json.Unmarshal(body, &current) != nil ||
+		current.DeviceID == "" || current.Time <= 0 || aws.ToString(output.ETag) == "" {
+		return ErrInvalid
+	}
+	if current.DeviceID != desired.DeviceID && time.Since(time.UnixMilli(current.Time)) < 65*time.Second {
+		return dejavu.ErrCloudLocked
+	}
+	object.IfMatch = aws.ToString(output.ETag)
+	return nil
+}
+
+func (s *Store) head(key string) (*s3.HeadObjectOutput, error) {
+	ctx, cancel := context.WithTimeout(s.life, 20*time.Second)
+	defer cancel()
+	return s.reader.HeadObject(ctx, &s3.HeadObjectInput{Bucket: &s.config.Bucket, Key: &key})
+}
+
+type grantResult struct {
+	grant uploadGrant
+	err   error
+}
+
+type grantBatch struct {
+	objects []uploadObject
+	replies map[string]chan grantResult
+}
+
+func (s *Store) authorize(object uploadObject) (uploadGrant, error) {
+	if strings.HasSuffix(object.Key, "/lock-sync") {
+		grants, err := s.authorizeBatch([]uploadObject{object})
+		return grants[object.Key], err
+	}
+	reply := make(chan grantResult, 1)
+	s.batchMu.Lock()
+	batch := s.batch
+	if batch == nil || len(batch.objects) == 100 || batch.replies[object.Key] != nil {
+		batch = &grantBatch{replies: map[string]chan grantResult{}}
+		s.batch = batch
+		time.AfterFunc(20*time.Millisecond, func() { s.submitGrantBatch(batch) })
+	}
+	batch.objects = append(batch.objects, object)
+	batch.replies[object.Key] = reply
+	s.batchMu.Unlock()
+	select {
+	case result := <-reply:
+		return result.grant, result.err
+	case <-s.life.Done():
+		return uploadGrant{}, ErrChanged
+	}
+}
+
+func (s *Store) submitGrantBatch(batch *grantBatch) {
+	s.batchMu.Lock()
+	if s.batch == batch {
+		s.batch = nil
+	}
+	s.batchMu.Unlock()
+	grants, err := s.authorizeBatch(batch.objects)
+	for key, reply := range batch.replies {
+		reply <- grantResult{grants[key], err}
+	}
+}
+
+func (s *Store) authorizeBatch(objects []uploadObject) (map[string]uploadGrant, error) {
+	input := struct {
+		ConfigVersion int64          `json:"configVersion"`
+		Objects       []uploadObject `json:"objects"`
+	}{s.config.ConfigVersion, objects}
+	var result struct {
+		ConfigVersion int64
+		Grants        []uploadGrant
+	}
+	err := s.request("upload-authorize", input, &result)
+	if err == Error("rate_limited") {
+		s.client.mu.Lock()
+		wait := time.Until(s.client.cooldown["upload-authorize"].until)
+		s.client.mu.Unlock()
+		if wait <= time.Minute {
+			select {
+			case <-s.life.Done():
+				return nil, ErrChanged
+			case <-time.After(max(0, wait)):
+				err = s.request("upload-authorize", input, &result)
+			}
+		}
+	}
+	if err != nil {
+		return nil, err
+	}
+	if result.ConfigVersion != s.config.ConfigVersion || len(result.Grants) != len(objects) {
+		return nil, ErrInvalid
+	}
+	wanted := make(map[string]uploadObject, len(objects))
+	for _, object := range objects {
+		wanted[object.Key] = object
+	}
+	grants := make(map[string]uploadGrant, len(objects))
+	ids := make(map[string]bool, len(objects))
+	for _, grant := range result.Grants {
+		object, exists := wanted[grant.Key]
+		if !exists || ids[grant.ID] || grants[grant.Key].ID != "" || !s.validGrant(grant, object) {
+			return nil, ErrInvalid
+		}
+		ids[grant.ID], grants[grant.Key] = true, grant
+	}
+	return grants, nil
+}
+
+func (s *Store) validGrant(grant uploadGrant, object uploadObject) bool {
+	dest, err := url.Parse(grant.URL)
+	if err != nil || dest.Scheme != "https" || dest.RawQuery == "" || dest.User != nil ||
+		dest.Fragment != "" || strings.ContainsAny(grant.URL, "\\#\r\n") || grant.Key != object.Key ||
+		!visible(grant.ID) || grant.ExpiresAt.IsZero() || time.Until(grant.ExpiresAt) > 5*time.Minute+time.Second {
+		return false
+	}
+	endpoint, _ := url.Parse(s.config.Endpoint)
+	host := endpoint.Host
+	key := object.Key
+	if s.config.ForcePathStyle {
+		key = s.config.Bucket + "/" + key
+	} else {
+		host = s.config.Bucket + "." + host
+	}
+	if !strings.EqualFold(host, dest.Host) || dest.Path != strings.TrimRight(endpoint.Path, "/")+"/"+key {
+		return false
+	}
+	headers := map[string]string{"content-length": strconv.Itoa(object.Size), "content-md5": object.MD5,
+		"content-type": "application/octet-stream"}
+	if object.IfMatch != "" {
+		headers["if-match"] = object.IfMatch
+	}
+	if object.IfNoneMatch != "" {
+		headers["if-none-match"] = object.IfNoneMatch
+	}
+	if len(headers) != len(grant.Headers) {
+		return false
+	}
+	for name, expected := range headers {
+		if grant.Headers[name] != expected {
+			return false
+		}
+	}
+	return true
+}
+
+func (s *Store) upload(grant uploadGrant, data []byte) error {
+	if !grant.ExpiresAt.After(time.Now()) {
+		return Error("storage_upload_expired")
+	}
+	if s.life.Err() != nil {
+		return ErrChanged
+	}
+	request, err := http.NewRequestWithContext(s.life, http.MethodPut, grant.URL, bytes.NewReader(data))
+	if err != nil {
+		return ErrInvalid
+	}
+	for name, value := range grant.Headers {
+		request.Header.Set(name, value)
+	}
+	response, err := s.put.Do(request)
+	if err != nil {
+		for _, pause := range []time.Duration{0, 400 * time.Millisecond, 1200 * time.Millisecond} {
+			select {
+			case <-s.life.Done():
+				return ErrChanged
+			case <-time.After(pause):
+				if s.complete(grant.ID) {
+					return nil
+				}
+			}
+		}
+		return Error("response_lost")
+	}
+	defer response.Body.Close()
+	_, _ = io.Copy(io.Discard, io.LimitReader(response.Body, 4096))
+	switch status := response.StatusCode; {
+	case status >= 200 && status < 300:
+		go s.complete(grant.ID)
+		return nil
+	case status == 409 || status == 412:
+		return Error("storage_conflict")
+	case status == 403 && !grant.ExpiresAt.After(time.Now()):
+		return Error("storage_upload_expired")
+	case status == 429:
+		return Error("rate_limited")
+	case status >= 500:
+		return Error("temporarily_unavailable")
+	}
+	return Error("storage_upload_failed")
+}
+
+func (s *Store) complete(id string) bool {
+	var out struct{ Results []struct{ ID, State string } }
+	err := s.request("upload-complete", map[string]any{
+		"configVersion": s.config.ConfigVersion, "grantIds": []string{id},
+	}, &out)
+	return err == nil && len(out.Results) == 1 && out.Results[0].ID == id && out.Results[0].State == "completed"
+}
+
+func (s *Store) RemoveObject(relative string) error {
+	key, err := s.objectKey(relative)
+	if err != nil {
+		return err
+	}
+	return s.request("objects-delete", map[string]any{"configVersion": s.config.ConfigVersion, "keys": []string{key}}, nil)
+}
+
+func (s *Store) request(action string, input, output any) error {
+	s.client.mu.Lock()
+	defer s.client.mu.Unlock()
+	if s.life.Err() != nil || !s.config.sameSource(s.client.config) {
+		return ErrChanged
+	}
+	ctx, cancel := context.WithTimeout(s.life, 20*time.Second)
+	defer cancel()
+	return s.client.authorized(ctx, action, input, output)
+}
+
+func (s *Store) String() string { return fmt.Sprintf("QingYu v%d", s.config.ProtocolVersion) }
