+// Translate the isolated Rust fixture's HTTP object endpoint only in this test.
+type loopbackFixtureTransport struct{}
+
+func (loopbackFixtureTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	if request.URL.Hostname() != "127.0.0.1" {
+		return nil, ErrInvalid
+	}
+	request = request.Clone(request.Context())
+	request.URL.Scheme = "http"
+	response, err := http.DefaultTransport.RoundTrip(request)
+	if err != nil || !strings.HasPrefix(request.URL.Path, "/api/client/v1/") {
+		return response, err
+	}
+	body, err := io.ReadAll(response.Body)
+	response.Body.Close()
+	if err != nil {
+		return nil, err
+	}
+	body = bytes.ReplaceAll(body, []byte(`"http://127.0.0.1:`), []byte(`"https://127.0.0.1:`))
+	response.Body = io.NopCloser(bytes.NewReader(body))
+	response.ContentLength = int64(len(body))
+	return response, nil
+}
