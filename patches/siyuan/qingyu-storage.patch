+import {fetchSyncPost} from "../../util/fetch";
+
+export const QINGYU_PROVIDER = 5;
+
+export const loadQingYuAccount = () => fetchSyncPost("/api/sync/getQingYuAccount", undefined, undefined, false);
+
+export const mountQingYuAccount = (panel: Element, root: Element) => {
+    if (panel.querySelector("[data-qingyu-account]")) {
+        return;
+    }
+    const zh = (window.siyuan.config.appearance.lang || "").startsWith("zh");
+    const text = {
+        email: zh ? "邮箱" : "Email",
+        password: zh ? "密码" : "Password",
+        login: zh ? "登录" : "Sign in",
+        logout: zh ? "退出轻羽" : "Sign out",
+        remember: zh ? "在此设备记住登录" : "Remember sign-in on this device",
+        failure: zh ? "无法连接轻羽，请检查网络后重试。" : "Could not connect to QingYu. Try again.",
+        notSaved: zh ? "会话未保存，重启后需要重新登录。" : "Sign in again after restarting.",
+        expired: zh ? "当前套餐无上传权限，可手动下载云端数据。" : "Your plan allows downloads only.",
+        binding: zh ? "轻羽账号或云仓库已变更，请核对当前工作空间的同步来源。" :
+            "The QingYu account or repository changed. Verify this workspace’s sync source.",
+        signup: zh ? "注册账号" : "Create account",
+        recovery: zh ? "找回密码" : "Reset password",
+        usage: zh ? "存储用量" : "Storage used",
+    };
+    panel.innerHTML = `
+<div data-qingyu-account class="config-account--auth">
+    <form class="fn__none" style="display: grid; gap: 16px;">
+        <label class="b3-form__icon">
+            <svg class="b3-form__icon-icon" aria-hidden="true"><use xlink:href="#iconAccount"></use></svg>
+            <input class="b3-text-field b3-form__icon-input fn__block" name="username" type="email" autocomplete="username" placeholder="${text.email}" aria-label="${text.email}" required>
+        </label>
+        <label class="b3-form__icon">
+            <svg class="b3-form__icon-icon" aria-hidden="true"><use xlink:href="#iconLock"></use></svg>
+            <input class="b3-text-field b3-form__icon-input fn__block" name="password" type="password" autocomplete="current-password" placeholder="${text.password}" aria-label="${text.password}" required>
+        </label>
+        <label class="ft__smaller ft__on-surface fn__flex" style="align-items: center; gap: 8px;">
+            <input name="remember" type="checkbox">${text.remember}
+        </label>
+        <button type="submit" class="b3-button fn__block">${text.login}</button>
+    </form>
+    <div data-signed-in class="fn__none">
+        <span data-name></span>
+        <button type="button" class="b3-button b3-button--outline">${text.logout}</button>
+        <div data-usage class="b3-label__text"></div>
+    </div>
+    <div class="b3-label__text" role="status"></div>
+    <div class="fn__flex" style="justify-content: center; flex-wrap: wrap; gap: 4px 16px; margin-top: 16px;">
+        <a class="b3-button b3-button--cancel" target="_blank" rel="noopener noreferrer" href="https://qynotes.com/forget/app-customers">${text.recovery}</a>
+        <a class="b3-button b3-button--cancel" target="_blank" rel="noopener noreferrer" href="https://qynotes.com/signup/app-customers">${text.signup}</a>
+    </div>
+</div>`;
+    const form = panel.querySelector("form")!;
+    const signedIn = panel.querySelector("[data-signed-in]")!;
+    const status = panel.querySelector("[role=status]")!;
+    const button = form.querySelector("button")!;
+    const logout = signedIn.querySelector("button")!;
+    const disabled = window.siyuan.config.readonly;
+    let pending = false;
+    let current: import("../../types/api").QingYuStatus | undefined;
+    const run = async (send: () => ReturnType<typeof loadQingYuAccount>) => {
+        if (pending || disabled) {
+            return;
+        }
+        pending = button.disabled = logout.disabled = true;
+        try {
+            const response = await send();
+            if (!form.isConnected) {
+                return;
+            }
+            if (response.data && "signedIn" in response.data) {
+                current = response.data;
+            }
+            const data = current;
+            form.classList.toggle("fn__none", !!data?.signedIn);
+            signedIn.classList.toggle("fn__none", !data?.signedIn);
+            signedIn.querySelector("[data-name]")!.textContent = data?.name ?? "";
+            const size = (bytes: number) => `${(bytes / (1024 * 1024)).toLocaleString(undefined, {maximumFractionDigits: 1})} MiB`;
+            signedIn.querySelector("[data-usage]")!.textContent = data && data.usedBytes >= 0 ?
+                `${text.usage} ${size(data.usedBytes)} / ${size(data.quotaBytes)}` : "";
+            status.textContent = response.code !== 0 ?
+                (response.msg === "account_changed" || response.msg === "storage_config_changed" ? text.binding : response.msg || text.failure) :
+                response.msg || (data?.signedIn && !data.canUpload ? text.expired : data?.signedIn && !data.remembered ? text.notSaved : "");
+            if (typeof data?.enabled === "boolean") {
+                window.siyuan.config.sync.enabled = data.enabled;
+                const toggle = root.querySelector<HTMLInputElement>('[id="sync.enabled"]');
+                if (toggle) {
+                    toggle.checked = data.enabled;
+                    toggle.disabled = !data.signedIn;
+                }
+            }
+        } catch {
+            status.textContent = text.failure;
+            form.classList.remove("fn__none");
+        } finally {
+            pending = button.disabled = logout.disabled = false;
+        }
+    };
+    form.addEventListener("submit", (event) => {
+        event.preventDefault();
+        if (pending) {
+            return;
+        }
+        const input = new FormData(form);
+        form.querySelector<HTMLInputElement>('[name="password"]')!.value = "";
+        void run(() => fetchSyncPost("/api/sync/loginQingYu", {
+            username: String(input.get("username") ?? ""), password: String(input.get("password") ?? ""),
+            remember: input.has("remember"),
+        }, undefined, false));
+    });
+    logout.addEventListener("click", () => {
+        void run(() => fetchSyncPost("/api/sync/logoutQingYu", undefined, undefined, false));
+    });
+    void run(loadQingYuAccount);
+};
