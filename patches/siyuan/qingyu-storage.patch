+func TestQingYuAgainstRustServer(t *testing.T) {
+	origin := os.Getenv("SIYUAN_QINGYU_FIXTURE_ORIGIN")
+	if origin == "" {
+		t.Skip("requires the local Rust server fixture")
+	}
+	if !strings.HasPrefix(origin, "http://127.0.0.1:") {
+		t.Fatal("fixture origin must be loopback")
+	}
+	ctx := context.Background()
+	key := bytes.Repeat([]byte{21}, 32)
+	setup := func(device string) *dejavu.Repo {
+		t.Helper()
+		client := New(origin, loopbackFixtureTransport{}, Tokens{}, nil)
+		if err := client.Login(ctx, "bridge@example.com", "samplepassword"); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = client.Logout(ctx) })
+		status, err := client.Probe(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		b, err := client.Store(&cloud.Conf{Dir: "main"}, status)
+		if err != nil {
+			t.Fatal(err)
+		}
+		w := t.TempDir()
+		r, err := dejavu.NewRepo(filepath.Join(w, "data"), filepath.Join(w, "repo"), filepath.Join(w, "history"),
+			filepath.Join(w, "temp"), device, device, "fixture", key, nil, b)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.MkdirAll(r.DataPath, 0755); err != nil {
+			t.Fatal(err)
+		}
+		return r
+	}
+	forward, back := setup("first"), setup("second")
+	for i, pair := range [][2]*dejavu.Repo{{forward, back}, {back, forward}} {
+		writer, reader := pair[0], pair[1]
+		data := []byte("QingYu local round trip " + strings.Repeat("note", i+1))
+		file := filepath.Join(writer.DataPath, "note.txt")
+		if err := os.WriteFile(file, data, 0600); err != nil {
+			t.Fatal(err)
+		}
+		modified := time.Now().Add(time.Duration(i) * 2 * time.Second)
+		if err := os.Chtimes(file, modified, modified); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := writer.Index("writer", true, nil); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := writer.SyncUpload(map[string]any{}); err != nil {
+			t.Fatal(err)
+		}
+		if i == 0 {
+			if err := os.WriteFile(filepath.Join(reader.DataPath, "seed.txt"), []byte("seed"), 0600); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if _, err := reader.Index("reader", true, nil); err != nil {
+			t.Fatal(err)
+		}
+		if _, _, err := reader.SyncDownload(map[string]any{}); err != nil {
+			t.Fatal(err)
+		}
+		got, err := os.ReadFile(filepath.Join(reader.DataPath, "note.txt"))
+		if err != nil || !bytes.Equal(got, data) {
+			t.Fatalf("round trip %d: %q, %v", i, got, err)
+		}
+	}
+}
